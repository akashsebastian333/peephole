#!/bin/sh
# Universal backstop: install as .git/hooks/pre-commit (chmod +x).
# Blocks the commit if a staged file has a high-confidence security finding.
if ! command -v peephole >/dev/null 2>&1; then
  echo "peephole: not on PATH; install the binary or skip with --no-verify" >&2
  exit 2
fi
peephole scan --gate --staged
