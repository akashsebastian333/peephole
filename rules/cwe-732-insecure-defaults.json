  "absence_requirements": [
    "Session/auth cookies should set HttpOnly, Secure, and SameSite=Lax|Strict; confirm these flags are present.",
    "Serve security headers by default (Content-Security-Policy, X-Content-Type-Options, HSTS) — a missing header is not visible in one hunk.",
    "Create files and temp files with least-privilege permissions (0600/0640), never world-writable."
  ],
  "attack_scenario": "an insecure default (world-writable files, an obsolete TLS version, a cookie without HttpOnly/Secure) leaves a gap the framework would have closed by default — a local user tampers with the file, a network attacker downgrades TLS, or JavaScript steals the session cookie",
  "negative_test_hint": ["create the resource with the insecure default and assert the hardened property holds - file mode \"0600 (owner-only)\", cookie HttpOnly+Secure+SameSite, no public ACL"],
  "exemplar": {
    "noncompliant": "os.chmod(path, 0o777)",
    "compliant": "os.chmod(path, 0o600)",
    "explanation": "grant least privilege by default; 0o777 lets any local user read and modify the file"
  }
