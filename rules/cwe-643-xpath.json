      "re": "\\.(?:selectNodes|evaluate)\\(\\s*(?:`[^`]*\\$\\{|[\"'][^\"']*[\"']\\s*\\+)"
    },
    {
      "lang": "python",
      "confidence": "high",
      "re": "\\.(?:findall?|findtext)\\(\\s*(?:f[\"']|\"[^\"]*\"\\s*(?:\\+|%|\\.format\\()|'[^']*'\\s*(?:\\+|%|\\.format\\())"
