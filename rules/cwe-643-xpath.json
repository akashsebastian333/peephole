  "attack_scenario": "attacker sends name = \"' or '1'='1\" so the XPath predicate always matches, returning every node (e.g. all credentials) instead of the intended record",
  "negative_test_hint": [
    "submit name = \"' or '1'='1\" and assert the query returns at most the one intended node"
  ],
  "exemplar": {
    "noncompliant": "tree.xpath(f\"//user[name='{name}']/password/text()\")",
    "compliant": "tree.xpath(\"//user[name=$n]/password/text()\", n=name)",
    "explanation": "use XPath variable binding ($n) instead of interpolating user input into the expression"
  }
