  "patterns": [
    {
      "lang": "python",
      "confidence": "high",
      "re": "(?i)(?:token|otp|nonce|secret|salt|session|reset|api_?key|password)[\\w\\[\\]'\\\".]*\\s*=\\s*[^;\\n]*\\brandom\\.(?:random|randint|randrange|choice|choices|getrandbits)\\(",
      "reject_re": "(?i)\\brandom\\.random\\(\\)\\s*\\*|_(?:amount|santa|refill|jitter|deck|count|delay|index|idx|color|colour|percent)\\b"
    },
    {
      "lang": "javascript",
      "confidence": "high",
      "re": "(?i)(?:token|otp|nonce|secret|salt|session|reset|api_?key|password|uuid)[\\w.]*\\s*=\\s*[^;\\n]*Math\\.random\\(\\)",
      "reject_re": "(?i)santa|colou?r|jitter|delay|deck|dice|percent|_amount|_count"
    },
    {
      "lang": "go",
      "confidence": "high",
      "re": "(?i)(?:token|secret|api_?key|nonce|salt|otp|session_?id|password|csrf)\\w*\\s*[:=]{1,2}[^\\n]{0,60}\\brand\\.(?:Intn|Int31|Int63|Uint32|Uint64|Float64|Int)\\(",
      "reject_re": "(?i)Refill|Jitter|Delay|Backoff|Float64\\(\\)\\s*\\*"
    },
    {
      "lang": "rust",
      "confidence": "high",
      "re": "(?i)(?:token|otp|nonce|secret|session)\\w*\\s*=\\s*[^;\\n]*\\brand::(?:random|thread_rng)",
      "reject_re": "(?i)OsRng|getrandom"
    },
    {
      "lang": "solidity",
      "confidence": "high",
      "re": "keccak256\\s*\\([^;]*\\bblock\\.(?:timestamp|number|difficulty|prevrandao|coinbase|gaslimit)"
    },
    {
      "lang": "solidity",
      "confidence": "high",
      "re": "keccak256\\s*\\([^;]*\\bblockhash\\s*\\("
    },
    {
      "lang": "solidity",
      "confidence": "medium",
      "re": "\\bblock\\.(?:timestamp|number|difficulty|prevrandao)\\s*%"
    },
    {
      "lang": "java",
      "confidence": "high",
      "re": "(?i)(?:token|otp|nonce|secret|salt|session_?id|reset|api_?key|password|csrf)\\w*\\s*=\\s*[^;\\n]*\\bnew\\s+(?:java\\.util\\.)?Random\\s*\\("
    },
    {
      "lang": "ruby",
      "confidence": "high",
      "re": "(?i)(?:token|otp|nonce|secret|salt|session|reset|api_?key|password)\\w*\\s*=\\s*[^;\\n]*\\brand\\s*\\("
    }
  ],
  "attack_scenario": "the value guards access (a token, OTP, reset link, or session id) but is generated by a non-cryptographic PRNG whose output an attacker can predict, letting them forge valid values \u2014 on-chain, block.timestamp/blockhash are miner-influenceable, so a lottery/winner drawn from them is predictable",
  "negative_test_hint": [
    "generate two tokens and assert the second is not predictable from the first - a \"Math.random()-based\" token is guessable from prior outputs"
  ],
  "exemplar": {
    "noncompliant": "reset_token = str(random.randint(100000, 999999))",
    "compliant": "import secrets\nreset_token = secrets.token_urlsafe(32)",
    "explanation": "use a cryptographically secure generator (secrets / os.urandom / crypto.randomBytes) for anything security-relevant"
  }
}
