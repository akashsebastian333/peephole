  "attack_scenario": "attacker crafts a serialized blob containing a gadget (pickle __reduce__, a YAML python/object tag, a node-serialize IIFE) so the act of deserializing executes attacker code",
  "negative_test_hint": [
    "feed a YAML payload '!!python/object/apply:os.system [\"id\"]' and assert it is rejected"
  ],
  "exemplar": {
    "noncompliant": "cfg = yaml.load(open(path))",
    "compliant": "cfg = yaml.safe_load(open(path))",
    "explanation": "safe_load constructs only plain data types; it cannot instantiate arbitrary Python objects"
