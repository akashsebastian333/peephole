  "attack_scenario": "attacker appends a shell metacharacter and a second command to the interpolated field; the shell parses and runs it with the service's privileges",
  "negative_test_hint": [
    "submit host = \"127.0.0.1; id\" and assert the second command does not run"
  ],
  "exemplar": {
    "noncompliant": "subprocess.run(f\"ping -c1 {host}\", shell=True)",
    "compliant": "subprocess.run([\"ping\", \"-c1\", host], shell=False, check=True, timeout=5)",
    "explanation": "argv list without a shell \u2014 metacharacters in host are passed as one literal argument, never parsed"
